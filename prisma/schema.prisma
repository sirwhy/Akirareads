// AKIRAREADS v3 — shared Postgres (Neon / Railway PG)
// Vercel web app + Railway worker membaca database yang sama.

// Dua generator: hasil generate HARUS berada di dalam root direktori masing-masing
// paket deploy (Vercel root=web, Railway root=worker). `prisma generate` di root
// (atau postinstall tiap paket) menulis ke dua lokasi ini sekaligus.
generator clientWeb {
  provider      = "prisma-client-js"
  output        = "../web/lib/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator clientWorker {
  provider      = "prisma-client-js"
  output        = "../worker/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  username      String        @unique
  password      String
  role          String        @default("USER")
  avatar        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      Comment[]
  bookmarks     Bookmark[]
  readHistory   ReadHistory[]
  @@map("users")
}

model Series {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  author      String?
  artist      String?
  status      String     @default("ONGOING")
  genres      String[]
  rating      Float      @default(0)
  views       Int        @default(0)
  cover       String?
  type        String     @default("MANHWA")
  featured    Boolean    @default(false)
  sourceUrl   String?
  sourceSite  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chapters    Chapter[]
  comments    Comment[]
  bookmarks   Bookmark[]
  @@map("series")
}

model Chapter {
  id         String        @id @default(cuid())
  seriesId   String
  title      String?
  chapterNum Float
  hash       String?       @unique  // hash dari daftar URL halaman asli → dedup & terjemahan cache lintas chapter repost
  views      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  series     Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  pages      Page[]
  readHistory ReadHistory[]
  translateJobs TranslateJob[] @relation("TranslateJobs")
  @@map("chapters")
}

model Page {
  id           String  @id @default(cuid())
  chapterId    String
  number       Int
  imageUrl     String            // halaman asli (hotlink / mirror)
  translatedUrl String?          // hasil akhir AI (text sudah dibakar di gambar)
  thumbUrl     String?           // versi kecil untuk webp/avif di Vercel image optimizer
  thumbW       Int?
  thumbH       Int?
  chapter      Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  translation  PageTranslation? @relation("PageTranslations")
  @@map("pages")
}

model TranslateJob {
  id         String   @id @default(cuid())
  chapterId  String
  chapter    Chapter  @relation("TranslateJobs", fields: [chapterId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING|RUNNING|DONE|FAILED
  progress   Int      @default(0)         // 0-100
  total      Int      @default(0)         // jumlah halaman
  done       Int      @default(0)
  message    String?
  error      String?
  targetLang String   @default("id")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status, createdAt])
  @@map("translate_jobs")
}

model PageTranslation {
  id           String   @id @default(cuid())
  pageId       String   @unique
  page         Page     @relation("PageTranslations", fields: [pageId], references: [id], onDelete: Cascade)
  chapterHash  String?           // cache lintas chapter kalau halaman identik
  sourceLang   String?
  textCount    Int      @default(0)
  ocrProvider  String?
  mtProvider   String?
  data         Json              // [{x,y,w,h,fontSize,color,bgColor,text,translation}]
  resultUrl    String            // data:image/... (base64 webp hasil inpaint akhir)
  createdAt    DateTime @default(now())
  @@index([chapterHash])
  @@map("page_translations")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  seriesId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  @@map("comments")
}

model Bookmark {
  id       String @id @default(cuid())
  userId   String
  seriesId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  @@unique([userId, seriesId])
  @@map("bookmarks")
}

model ReadHistory {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  @@unique([userId, chapterId])
  @@map("read_history")
}

model MirrorJob {
  id         String   @id @default(cuid())
  sourceUrl  String
  sourceSite String?
  status     String   @default("PENDING")
  progress   Int      @default(0)
  total      Int      @default(0)
  message    String?
  seriesId   String?
  result     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@map("mirror_jobs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  @@map("settings")
}

model Ad {
  id        String   @id @default(cuid())
  name      String
  position  String
  code      String   @db.Text
  imageUrl  String?
  linkUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("ads")
}
