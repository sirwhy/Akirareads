# ── AKIRAREADS v3 — Variabel environment ──
# Salin jadi .env untuk dev lokal. Di produksi: isi di Vercel (web) & Railway (worker).

# Wajib (web + worker)
DATABASE_URL=postgresql://user:pass@host:5432/akirareads?sslmode=require

# Wajib (web)
JWT_SECRET=ganti-dengan-string-random-panjang
ADMIN_API_KEY=ganti-dengan-kunci-admin-acak
ADMIN_EMAIL=admin@kamu.com
ADMIN_PASSWORD=GantiPasswordAdmin!

# Wajib (worker) — URL publik worker (Railway domain)
WORKER_URL=https://akira-worker.up.railway.app

# Opsional (worker) — sumber AI; isi ≥1. Chain: gemini → openai → groq
TRANSLATE_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Opsional (worker)
AUTO_TRANSLATE=1
POLL_MS=5000
DATA_DIR=/data

# Opsional — backup Google Drive (service account, share folder ke email SA)
GOOGLE_SA_JSON=
GDRIVE_FOLDER_ID=
BACKUP_CRON=0 3 * * *

# Hanya untuk web (NEXT_PUBLIC_* dikirim ke browser — admin key memang dipakai
# client-side oleh script Browser Import, sama seperti v2)
NEXT_PUBLIC_ADMIN_KEY=ganti-dengan-kunci-admin-acak
